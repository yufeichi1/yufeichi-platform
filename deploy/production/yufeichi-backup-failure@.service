[Unit]
Description=Record Yufeichi backup failure for %i

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/bin/bash /opt/yufeichi/deploy/backup-failure.sh %i
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/yufeichi/backup-status
StandardOutput=journal
StandardError=journal
