# Copy outside the repository to a protected backend.env (chmod 600).
# Supply fresh secrets locally; empty required values intentionally prevent startup.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yufeichi
DB_USERNAME=yufeichi
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_SECRET=
JWT_EXPIRE_MINUTES=45
UPLOAD_PATH=/var/lib/yufeichi/uploads
LOG_PATH=/var/log/yufeichi/backend
# Only set after verifying Nginx overwrites X-Real-IP and backend is inaccessible directly.
TRUSTED_PROXIES=
# One-time offline process only; remove both from the runtime environment afterwards.
# BOOTSTRAP_USERNAME=
# BOOTSTRAP_PASSWORD=

# Summary is independently switchable. Only explicitly generated content leaves the backend.
AI_SUMMARY_ENABLED=true
# Daily estimated CNY cap, Asia/Shanghai day. No recharge; unknown usage keeps the reservation.
AI_COST_ENABLED=true
AI_DAILY_COST_CAP=5
# Official 2026-11-08 peak/non-cache prices, CNY per million tokens; recheck before changing models.
AI_CHAT_INPUT_CNY_PER_MILLION=2
AI_CHAT_OUTPUT_CNY_PER_MILLION=8
AI_EMBEDDING_INPUT_CNY_PER_MILLION=0.125
AI_COST_CHAT_MODEL=deepseek-flash
AI_COST_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
AI_COST_PRICE_DATE=2026-11-08
