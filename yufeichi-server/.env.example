# Names are explicitly mapped in application.yml. This file is a template, not auto-loaded by Java.
AI_ENABLED=false
AI_KNOWLEDGE_ENABLED=false
AI_KNOWLEDGE_SIMILARITY_THRESHOLD=0.5
AI_PROVIDER_BASE_URL=
AI_COMPLETIONS_PATH=/v1/chat/completions
AI_API_KEY=
AI_CHAT_MODEL=
AI_JSON_MODE=true
# Blank: official api.deepseek.com uses none; other providers omit reasoning_effort.
AI_REASONING_EFFORT=
AI_REQUEST_TIMEOUT_SECONDS=60
AI_INDEX_TIMEOUT_SECONDS=300
AI_CONNECT_TIMEOUT_SECONDS=5
AI_HEARTBEAT_SECONDS=10
AI_MAX_OUTPUT_TOKENS=800
AI_MAX_INPUT_CHARS=12000
AI_MAX_CONCURRENT_REQUESTS=2
AI_USER_MINUTE_LIMIT=3
AI_USER_DAILY_LIMIT=10
AI_DAILY_REQUEST_LIMIT=100
# Separate embedding provider. Indexing requires vector config; RAG needs an activated public-content index.
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=1024
AI_EMBEDDING_PATH=
AI_VECTOR_ENABLED=false
AI_VECTOR_URL=
AI_VECTOR_USERNAME=
AI_VECTOR_PASSWORD=

# Anonymous RAG is opt-in; automatic post-commit indexing is independently opt-in.
AI_PUBLIC_ENABLED=false
AI_INDEX_SYNC_ENABLED=false
AI_INDEX_RETRY_DELAY_SECONDS=60

# Fixed read-only keyword workflow; no model calls.
AI_TOOLS_ENABLED=false
AI_AGENT_ENABLED=false
AI_KNOWLEDGE_TOP_K=6

# Summary is independently switchable. Only explicitly generated content leaves the backend.
AI_SUMMARY_ENABLED=true
# Daily estimated CNY cap, Asia/Shanghai day. No recharge; unknown usage keeps the reservation.
AI_COST_ENABLED=true
AI_DAILY_COST_CAP=5
# Official 2026-11-08 peak/non-cache prices, CNY per million tokens; recheck before changing models.
AI_CHAT_INPUT_CNY_PER_MILLION=2
AI_CHAT_OUTPUT_CNY_PER_MILLION=8
AI_EMBEDDING_INPUT_CNY_PER_MILLION=0.125
AI_COST_CHAT_MODEL=deepseek-flash
AI_COST_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
AI_COST_PRICE_DATE=2026-11-08
